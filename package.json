{
  "name": "nexus-login-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch server/index.mjs\" \"vite --host localhost\"",
    "build": "tsc -b && vite build",
    "start": "PORT=5173 ISSUER=http://localhost:5173/oidc node server/index.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "oidc-provider": "^9.5.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
